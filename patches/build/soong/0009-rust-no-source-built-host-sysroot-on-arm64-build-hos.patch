From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Martin=20=C5=A0trobl?= <recordyletsplays@gmail.com>
Date: Sat, 14 Nov 2026 00:06:11 +0100
Subject: [PATCH 9/9] rust: no source-built host sysroot on arm64 build hosts

rust_sysroot_defaults builds the sysroot crates (libstd, libcore,
liballoc, ...) from source for musl_arm64, which on x86 build hosts is
only a host cross target. On an arm64 build host linux_musl_arm64 is the
native host: Rust modules there link the prebuilt libstd, but a cc
module's static dependency on "libstd" resolved to the source-built one.
Both then met in one crate graph, e.g. in the generated Rust staticlib
of dex2oatd:

  error[E0464]: multiple candidates for `rlib` dependency `core` found
  error[E0152]: duplicate lang item in crate `std`: `panic_impl`

Disable the sysroot toolchain libraries for the native arm64 musl host,
as rust_sysroot_defaults does for musl on x86 hosts, so "libstd" is the
prebuilt everywhere. Device and x86 host builds are unchanged.
---
 rust/toolchain_library.go | 29 +++++++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/rust/toolchain_library.go b/rust/toolchain_library.go
index babfc2f..906d110 100644
--- a/rust/toolchain_library.go
+++ b/rust/toolchain_library.go
@@ -94,10 +94,39 @@ func initToolchainLibrary(module *Module, library *libraryDecorator) android.Mod
 	module.compiler = toolchainLibrary
 	module.AddProperties(&toolchainLibrary.Properties)
 	android.AddLoadHook(module, rustSetToolchainSource)
+	android.AddLoadHook(module, rustDisableHostSysrootOnArm64)
 
 	return module.Init()
 }
 
+// rust_sysroot_defaults builds the sysroot crates from source for musl_arm64,
+// which on x86 build hosts is only a host cross target. On arm64 build hosts it
+// is the native host, which uses the prebuilt libstd like linux_musl_x86_64
+// does on x86 hosts. Disable the source-built sysroot crates for it, as
+// rust_sysroot_defaults does for musl on x86 hosts, so that "libstd" resolves
+// to the prebuilt everywhere and only one std ends up in a crate graph.
+func rustDisableHostSysrootOnArm64(ctx android.LoadHookContext) {
+	if ctx.Config().BuildOS != android.LinuxMusl || ctx.Config().BuildArch != android.Arm64 {
+		return
+	}
+	name := ctx.ModuleName()
+	if name != "libstd" && !strings.HasSuffix(name, ".rust_sysroot") {
+		return
+	}
+	type targetProps struct {
+		Enabled *bool
+	}
+	p := &struct {
+		Target struct {
+			Musl_arm64       targetProps
+			Linux_musl_arm64 targetProps
+		}
+	}{}
+	p.Target.Musl_arm64.Enabled = proptools.BoolPtr(false)
+	p.Target.Linux_musl_arm64.Enabled = proptools.BoolPtr(false)
+	ctx.AppendProperties(p)
+}
+
 type toolchainCompiler interface {
 	toolchainCrateRoot() *string
 	toolchainSrcs() []string
