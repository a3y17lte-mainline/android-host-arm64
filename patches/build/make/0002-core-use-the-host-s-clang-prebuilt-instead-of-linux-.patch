From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Martin=20=C5=A0trobl?= <recordyletsplays@gmail.com>
Date: Fri, 13 Nov 2026 20:03:37 +0100
Subject: [PATCH 2/2] core: use the host's clang prebuilt instead of linux-x86

Several make paths into the clang prebuilts hardcoded $(BUILD_OS)-x86 or
linux-x86 (llvm-readobj, the runtime library dir, libexec, the NDK
libc++_shared.so), so an arm64 host picked x86 binaries. Use
$(HOST_PREBUILT_TAG), which is linux-x86 on x86_64 hosts as before.

Add clang/HOST_arm64.mk. arm64 hosts build against musl, so the host
profile and builtins runtimes come from the aarch64-unknown-linux-musl
runtime directory.
---
 core/binary.mk                    | 4 ++--
 core/clang/HOST_arm64.mk          | 3 +++
 core/clang/config.mk              | 4 ++--
 core/install_jni_libs_internal.mk | 2 +-
 4 files changed, 8 insertions(+), 5 deletions(-)
 create mode 100644 core/clang/HOST_arm64.mk

diff --git a/core/binary.mk b/core/binary.mk
index cb23c45..2cc9fb9 100644
--- a/core/binary.mk
+++ b/core/binary.mk
@@ -266,7 +266,7 @@ ifneq ($(LOCAL_SDK_VERSION),)
     my_ndk_stl_include_path := $(my_ndk_source_root)/cxx-stl/system/include
     my_system_shared_libraries += libstdc++
   else ifneq (,$(filter c++_%, $(LOCAL_NDK_STL_VARIANT)))
-    my_llvm_dir := $(LLVM_PREBUILTS_BASE)/$(BUILD_OS)-x86/$(LLVM_PREBUILTS_VERSION)
+    my_llvm_dir := $(LLVM_PREBUILTS_BASE)/$(HOST_PREBUILT_TAG)/$(LLVM_PREBUILTS_VERSION)
     my_libcxx_arch_dir := $(my_llvm_dir)/android_libc++/ndk/$($(LOCAL_2ND_ARCH_VAR_PREFIX)PREBUILT_LIBCXX_ARCH_DIR)
 
     # Include the target-specific __config_site file followed by the generic libc++ headers.
@@ -1780,7 +1780,7 @@ ifeq ($(strip $(my_cc)),)
 endif
 
 SYNTAX_TOOLS_PREFIX := \
-    $(LLVM_PREBUILTS_BASE)/$(BUILD_OS)-x86/$(LLVM_PREBUILTS_VERSION)/libexec
+    $(LLVM_PREBUILTS_BASE)/$(HOST_PREBUILT_TAG)/$(LLVM_PREBUILTS_VERSION)/libexec
 
 ifneq ($(LOCAL_NO_STATIC_ANALYZER),true)
   my_cc := CCC_CC=$(CLANG) CLANG=$(CLANG) \
diff --git a/core/clang/HOST_arm64.mk b/core/clang/HOST_arm64.mk
new file mode 100644
index 0000000..bf515c7
--- /dev/null
+++ b/core/clang/HOST_arm64.mk
@@ -0,0 +1,3 @@
+# arm64 hosts build against musl: the host runtimes are in the per-target dir.
+HOST_LIBPROFILE_RT := $(dir $(LLVM_RTLIB_PATH:%/=%))aarch64-unknown-linux-musl/libclang_rt.profile.a
+HOST_LIBCRT_BUILTINS := $(dir $(LLVM_RTLIB_PATH:%/=%))aarch64-unknown-linux-musl/libclang_rt.builtins.a
diff --git a/core/clang/config.mk b/core/clang/config.mk
index c20cfab..fbc6d89 100644
--- a/core/clang/config.mk
+++ b/core/clang/config.mk
@@ -1,8 +1,8 @@
 ## Clang configurations.
 
-LLVM_READOBJ := $(LLVM_PREBUILTS_BASE)/$(BUILD_OS)-x86/$(LLVM_PREBUILTS_VERSION)/bin/llvm-readobj
+LLVM_READOBJ := $(LLVM_PREBUILTS_BASE)/$(HOST_PREBUILT_TAG)/$(LLVM_PREBUILTS_VERSION)/bin/llvm-readobj
 
-LLVM_RTLIB_PATH := $(wildcard $(LLVM_PREBUILTS_BASE)/linux-x86/$(LLVM_PREBUILTS_VERSION)/lib/clang/*)/lib/linux/
+LLVM_RTLIB_PATH := $(wildcard $(LLVM_PREBUILTS_BASE)/$(HOST_PREBUILT_TAG)/$(LLVM_PREBUILTS_VERSION)/lib/clang/*)/lib/linux/
 
 define convert-to-clang-flags
 $(strip $(filter-out $(CLANG_CONFIG_UNKNOWN_CFLAGS),$(1)))
diff --git a/core/install_jni_libs_internal.mk b/core/install_jni_libs_internal.mk
index 4959edd..d452f58 100644
--- a/core/install_jni_libs_internal.mk
+++ b/core/install_jni_libs_internal.mk
@@ -40,7 +40,7 @@ ifdef my_embed_jni
     endif
     my_libcxx_arch := $($(LOCAL_2ND_ARCH_VAR_PREFIX)PREBUILT_LIBCXX_ARCH_DIR)
     my_jni_shared_libraries += \
-        $(LLVM_PREBUILTS_BASE)/$(BUILD_OS)-x86/$(LLVM_PREBUILTS_VERSION)/android_libc++/ndk/$(my_libcxx_arch)/lib/libc++_shared.so
+        $(LLVM_PREBUILTS_BASE)/$(HOST_PREBUILT_TAG)/$(LLVM_PREBUILTS_VERSION)/android_libc++/ndk/$(my_libcxx_arch)/lib/libc++_shared.so
   endif
 
   # Set the abi directory used by the local JNI shared libraries.
