<?xml version="1.0" encoding="UTF-8"?>
<!--
  Put this file in .repo/local_manifests/ of a LineageOS 24.0 tree.

  - tools/android-host-arm64: this repo (setup.sh, env.sh, patches)
  - the AOSP linux-arm64 clang and Go prebuilts. The x86 projects stay:
    their Android.bp files define modules Soong needs. The arm64 projects
    have no android-17 tags; these commits match the tree's versions:
      clang: a70cecf3 has clang-r584948b and clang-r596125 (LineageOS cp2a's
             RELEASE_BUILD_CLANG_VERSION; same LLVM revision as linux-x86) and
             no Android.bp. Later commits add one using llvm_host_arch_filegroup,
             which this Soong does not know. setup.sh links clang-r584948
             (ClangDefaultVersion) to clang-r584948b.
      go:    go1.25.4, same as prebuilts/go/linux-x86 at android-17.0.0_r1
-->
<manifest>
  <remote name="a3y17lte" fetch="https://github.com/a3y17lte-mainline" />

  <project path="tools/android-host-arm64" name="android-host-arm64"
           remote="a3y17lte" revision="main" />

  <project path="prebuilts/clang/host/linux-arm64"
           name="platform/prebuilts/clang/host/linux-arm64"
           remote="aosp" clone-depth="1"
           revision="a70cecf3ce95d669302703e43c38c823af3f8513"
           upstream="mirror-google-llvm-r614150-release" />
  <project path="prebuilts/go/linux-arm64"
           name="platform/prebuilts/go/linux-arm64"
           remote="aosp" clone-depth="1"
           revision="85088d1ab9a678cc8531f9cc05de9fa802f91c58"
           upstream="mirror-goog-llvm-r596125-release" />
</manifest>
